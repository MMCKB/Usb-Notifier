<Window
    x:Class="UsbFlashToast.Views.OverviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UsbFlashToast.Models">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 背景材质叠加层：用于薄雾 / 磨砂 / 亚克力（薄）等需要对亚克力做色调调整的场景 -->
        <Rectangle x:Name="BackdropOverlay" Grid.Row="0" Grid.RowSpan="2"
                   Fill="Transparent" IsHitTestVisible="False" />

        <!-- ================= 标题栏 ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- 为左侧拖拽区域/系统菜单预留空间 -->
            <Border Grid.Column="0" Background="Transparent" />

            <Viewbox Grid.Column="1" Width="18" Height="18" Margin="16,0,10,0"
                     VerticalAlignment="Center">
                <Path Fill="{ThemeResource AccentFillColorDefaultBrush}"
                      Data="M9 1.5h6v1.8H13.2v4.2h1.8v1.8h5.2a2 2 0 0 1 2 2v9.3a2 2 0 0 1-2 2H3.8a2 2 0 0 1-2-2V11.3a2 2 0 0 1 2-2H9V7.5H7.2V1.5z" />
            </Viewbox>
            <TextBlock Grid.Column="2" Text="弹盘通"
                       VerticalAlignment="Center" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                        Margin="0,0,16,0" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Padding="10,6" Click="OnRefreshClick"
                        ToolTipService.ToolTip="重新检测设备">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="SettingsButton" Padding="10,6" ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="SettingsFlyout" Placement="Bottom" Opened="OnSettingsFlyoutOpened">
                            <StackPanel x:Name="SettingsPanel" Width="260" Spacing="14"
                                        RenderTransformOrigin="0.5,0"
                                        Opacity="0">
                                <StackPanel.RenderTransform>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                </StackPanel.RenderTransform>
                                <TextBlock Text="材质背景" FontWeight="SemiBold" FontSize="14" />
                                <RadioButtons x:Name="BackdropRadioButtons" MaxColumns="1">
                                    <RadioButton Content="亚克力" Tag="Acrylic" />
                                    <RadioButton Content="亚克力（薄）" Tag="AcrylicThin" />
                                    <RadioButton Content="薄雾" Tag="Smoke" />
                                    <RadioButton Content="磨砂" Tag="Frosted" />
                                    <RadioButton Content="云母" Tag="Mica" />
                                    <RadioButton Content="云母 Alt" Tag="MicaAlt" />
                                    <RadioButton Content="纯色" Tag="Solid" />
                                    <RadioButton Content="透明" Tag="Transparent" />
                                </RadioButtons>
                                <ToggleSwitch x:Name="StartupToggle" Header="开机自动启动" />
                                <ComboBox x:Name="CloseActionCombo" Header="关闭窗口时"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnCloseActionChanged">
                                    <x:String>每次询问</x:String>
                                    <x:String>直接退出应用</x:String>
                                    <x:String>隐藏到托盘</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- 为系统标题栏按钮预留空间 -->
            <Border x:Name="RightPadding" Grid.Column="5" Background="Transparent" />

            <!-- 标题栏与内容区的视觉分隔 -->
            <Border Grid.Column="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom"
                    Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" 
                    Opacity="0.6" IsHitTestVisible="False" />
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="已连接的设备" Margin="18,8,12,8"
                               Style="{StaticResource SubtleTextStyle}" />

                    <ListView x:Name="DriveList" Grid.Row="1"
                              SelectionChanged="OnDriveSelectionChanged"
                              Padding="8,0,8,8">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UsbDriveInfo">
                                <Grid Padding="4,8,4,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                            Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Letter}" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding VolumeLabel}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding DeviceKind}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding FileSystem}" />
                                    </TextBlock>
                                    <ProgressBar Grid.Row="2" Grid.Column="1"
                                                 Margin="0,5,0,0" Height="4" CornerRadius="2"
                                                 Maximum="100" Value="{Binding UsedRatioPercent}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyHint" Grid.Row="1"
                               Text="尚未检测到 U 盘&#x0a;插入设备后会自动通知你"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="24,0" VerticalAlignment="Center"
                               Style="{StaticResource SubtleTextStyle}" />

                    <Button Grid.Row="2" x:Name="HideButton" Margin="12,4,12,12"
                            HorizontalAlignment="Stretch" Click="OnHideClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE751;" FontSize="13" />
                            <TextBlock Text="隐藏到托盘" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 详情 -->
            <ScrollViewer Grid.Column="1" Padding="0,0,0,24">
                <StackPanel Margin="24,4,24,0" Spacing="14">

                    <TextBlock x:Name="DetailEmptyHint"
                               Text="从左侧选择一个设备以查看概览"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,40,0,0" HorizontalAlignment="Center" />

                    <!-- 头部 -->
                    <Border x:Name="HeaderCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <Viewbox Width="30" Height="30">
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                          Data="M9 1.5h6v1.8H13.2v4.2h1.8v1.8h5.2a2 2 0 0 1 2 2v9.3a2 2 0 0 1-2 2H3.8a2 2 0 0 1-2-2V11.3a2 2 0 0 1 2-2H9V7.5H7.2V1.5z" />
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DriveTitle" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DriveSubtitle" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}"
                                        Padding="14,7" Click="OnOpenClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                        <TextBlock Text="打开 U 盘" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ScanButton" Padding="13,7" Click="OnScanClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                                        <TextBlock Text="分析内容" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EjectButton" Padding="13,7" Click="OnEjectClick"
                                        ToolTipService.ToolTip="安全弹出设备">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="13" />
                                        <TextBlock Text="弹出" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 容量 -->
                    <Border x:Name="CapacityCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="存储空间" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="CapacitySummary" HorizontalAlignment="Right"
                                           Style="{StaticResource SubtleTextStyle}" />
                            </Grid>

                            <ProgressBar x:Name="CapacityBar" Height="14" CornerRadius="7"
                                         Minimum="0" Maximum="100" />
                            <Grid Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="10" Height="10" CornerRadius="3"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="UsedLegend" Style="{StaticResource SubtleTextStyle}" />
                                    <Border Width="10" Height="10" CornerRadius="3" Margin="12,0,0,0"
                                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                    <TextBlock x:Name="FreeLegend" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 属性 -->
                    <Border x:Name="PropertyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="设备信息" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Text="卷标" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropLabel" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                    <TextBlock Text="文件系统" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropFileSystem" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="总容量" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropTotal" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Text="簇大小" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropCluster" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,14">
                                    <TextBlock Text="扇区大小" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropSector" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="序列号" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropSerial" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Text="设备型号" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropModel" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,14">
                                    <TextBlock Text="接口类型" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropInterface" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="分区情况" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropPartition" Style="{StaticResource PropertyValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="设备路径" Style="{StaticResource PropertyLabelStyle}" />
                                    <TextBlock x:Name="PropDevicePath" Style="{StaticResource PropertyValueStyle}"
                                               FontSize="11" Opacity="0.75" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 提示 -->
                    <InfoBar x:Name="HealthBar" IsOpen="False" IsClosable="True" CornerRadius="10" />

                    <!-- 内容分析 -->
                    <Border x:Name="ContentCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="内容构成" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="ScanSummary" HorizontalAlignment="Right"
                                           Style="{StaticResource SubtleTextStyle}" />
                            </Grid>

                            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True"
                                         Visibility="Collapsed" Margin="0,0,0,10" />

                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryStat">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="2" Height="8" CornerRadius="4"
                                                         Margin="6,0,12,0" Maximum="100"
                                                         Value="{Binding RatioPercent}" />
                                            <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Bytes, Converter={StaticResource SizeConverter}}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Count}" />
                                                <Run Text=" 个" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="LargestTitle" Text="体积最大的文件"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,6"
                                       Visibility="Collapsed" />
                            <ListView x:Name="LargestFiles" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="OnFileItemClick"
                                      MaxHeight="240" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileEntry">
                                        <Grid Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Width="90" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Size, Converter={StaticResource SizeConverter}}" />
                                            <TextBlock Grid.Column="2" Width="90" FontSize="12" TextAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Modified, Converter={StaticResource DateTimeConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
