<Window
    x:Class="UsbFlashToast.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="0">
        <!-- 用于 Frosted / Smoke 等材质的叠加层 -->
        <Rectangle x:Name="BackdropOverlay" Fill="Transparent" IsHitTestVisible="False" />

        <Border x:Name="Card"
                Background="Transparent"
                CornerRadius="12">

            <Grid>
                <!-- ============ 设备插入 ============ -->
                <Grid x:Name="DrivePanel" Padding="16,14,14,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40" Height="40" CornerRadius="10"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                            <Viewbox Width="24" Height="24">
                                <Path Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                      Data="M9 1.5h6v1.8H13.2v4.2h1.8v1.8h5.2a2 2 0 0 1 2 2v9.3a2 2 0 0 1-2 2H3.8a2 2 0 0 1-2-2V11.3a2 2 0 0 1 2-2H9V7.5H7.2V1.5z" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubtitleText"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="CloseButton"
                                Width="30" Height="30" Padding="0"
                                VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Click="OnCloseClick" ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <ProgressBar x:Name="UsageBar"
                                     Height="6" CornerRadius="3"
                                     Minimum="0" Maximum="100" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="UsageText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FreeText"
                                       FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" Spacing="8">
                        <Button x:Name="OpenButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,6" Click="OnOpenClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                                <TextBlock Text="打开 U 盘" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OverviewButton" Padding="12,6" Click="OnOverviewClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                                <TextBlock Text="查看概览" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EjectButton" Padding="12,6" Click="OnEjectClick"
                                ToolTipService.ToolTip="安全弹出设备">
                            <FontIcon Glyph="&#xE7FC;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============ 提示消息 ============ -->
                <Grid x:Name="NoticePanel" Visibility="Collapsed">
                    <InfoBar x:Name="NoticeBar"
                             IsOpen="True"
                             Severity="Success"
                             IsClosable="False"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,12,16,12" />
                </Grid>

                <!-- ============ 已拔出（线条动画，无色块背景） ============ -->
                <Grid x:Name="RemovedPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                        <Canvas Width="200" Height="86" HorizontalAlignment="Center">
                            <!-- USB 接口（母口，静态）：外框 + 内槽 + 触点 -->
                            <Rectangle Canvas.Left="16" Canvas.Top="22" Width="34" Height="42"
                                       RadiusX="3" RadiusY="3"
                                       Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                       StrokeThickness="2" />
                            <Rectangle Canvas.Left="23" Canvas.Top="30" Width="20" Height="26"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                       StrokeThickness="1.5" />
                            <Line X1="27" Y1="37" X2="39" Y2="37"
                                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" />
                            <Line X1="27" Y1="47" X2="39" Y2="47"
                                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" />

                            <!-- 速度线（拔出瞬间闪现，向右运动） -->
                            <Line x:Name="SpeedLine1" X1="18" Y1="12" X2="8" Y2="6"
                                  Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                  StrokeThickness="1.5" Opacity="0" />
                            <Line x:Name="SpeedLine2" X1="30" Y1="9" X2="22" Y2="2"
                                  Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                  StrokeThickness="1.5" Opacity="0" />

                            <!-- U 盘（公头，整体向右拔出）：金属接头 + 触点 + 本体 + 指示灯 -->
                            <Canvas x:Name="RemovedUsb" Canvas.Left="42" Canvas.Top="19"
                                    Width="78" Height="48">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="UsbSlide" X="0" />
                                </Canvas.RenderTransform>

                                <Rectangle Canvas.Left="0" Canvas.Top="7" Width="26" Height="34"
                                           RadiusX="2" RadiusY="2"
                                           Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                           StrokeThickness="2" />
                                <Line X1="5" Y1="17" X2="21" Y2="17"
                                      Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" />
                                <Line X1="5" Y1="27" X2="21" Y2="27"
                                      Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" />
                                <Rectangle Canvas.Left="24" Canvas.Top="0" Width="50" Height="48"
                                           RadiusX="8" RadiusY="8"
                                           Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                           StrokeThickness="2" />
                                <Line X1="34" Y1="13" X2="64" Y2="13"
                                      Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="42" Canvas.Top="27" Width="8" Height="8"
                                         Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" />
                            </Canvas>
                        </Canvas>

                        <TextBlock x:Name="RemovedText"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
